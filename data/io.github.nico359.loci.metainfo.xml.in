<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.loci</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Loci</name>
  <summary>Turn-by-turn navigation for mobile Linux</summary>
  <description>
    <p>Loci is a navigation app designed for mobile Linux devices. It provides turn-by-turn directions with automatic rerouting when you leave the route, map rotation to follow your direction of travel, and a clean interface inspired by GNOME Maps.</p>
    <p>Location is sourced from the XDG Location Portal (GeoClue) and routing from the Valhalla routing engine. The map snaps the position indicator to the road when on-route. </p>
  </description>

  <icon type="stock">io.github.nico359.loci</icon>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/loci</url>
  <url type="vcs-browser">https://github.com/nico359/loci</url>
  <url type="bugtracker">https://github.com/nico359/loci/issues</url>

  <recommends>
    <display_length compare="ge">360</display_length>
    <control>touch</control>
  </recommends>
  <supports>
    <control>touch</control>
  </supports>

  <translation type="gettext">loci</translation>
  <launchable type="desktop-id">io.github.nico359.loci.desktop</launchable>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2026-05-09">
      <description translate="no">
        <p>Initial release.</p>
        <ul>
          <li>Turn-by-turn navigation with maneuver instructions</li>
          <li>Map rotation following direction of travel</li>
          <li>Automatic rerouting when off-route</li>
          <li>Route snapping — position indicator follows the road</li>
          <li>Address search via Nominatim geocoding</li>
          <li>Location via the XDG Location Portal (GeoClue)</li>
          <li>Routing via the Valhalla engine</li>
          <li>Screen idle inhibit during navigation</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
