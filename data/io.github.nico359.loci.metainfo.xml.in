<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.loci</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Loci</name>
  <summary>Turn-by-turn navigation (mostly) for Linux phones</summary>
  <description>
    <p>Loci is a navigation app designed for mobile Linux devices. It provides turn-by-turn directions with automatic rerouting when you leave the route, map rotation to follow your direction of travel, and a clean interface inspired by GNOME Maps.</p>
    <p>Location is sourced from the XDG Location Portal (GeoClue) and routing from OSRM in combination with Ferrostar. The map snaps the position indicator to the road when on-route. </p>
    <p>Disclaimer: For informational purposes only. Do not use while driving. Navigation data may be inaccurate or incomplete - never rely solely on this app for navigation or safety-critical decisions.</p>
  </description>

  <icon type="stock">io.github.nico359.loci</icon>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <url type="homepage">https://github.com/nico359/loci</url>
  <url type="vcs-browser">https://github.com/nico359/loci</url>
  <url type="bugtracker">https://github.com/nico359/loci/issues</url>

  <supports>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <translation type="gettext">loci</translation>
  <launchable type="desktop-id">io.github.nico359.loci.desktop</launchable>
  <content_rating type="oars-1.1" />

